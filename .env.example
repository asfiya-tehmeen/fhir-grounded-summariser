# Copy to .env and fill in what you use. .env is git-ignored.

# Groq free tier (default model for evaluation on SYNTHETIC data). https://console.groq.com/keys
GROQ_API_KEY=

# Optional: Claude via Anthropic API (pip install -e ".[anthropic]"). https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: local model for MIMIC runs if you prefer data never leaves the machine (https://ollama.com)
# OLLAMA_HOST=http://localhost:11434

# Optional per-provider model overrides used by the web app
# FHIRSUM_GROQ_MODEL=openai/gpt-oss-120b
# FHIRSUM_ANTHROPIC_MODEL=claude-opus-5-5
# FHIRSUM_OLLAMA_MODEL=qwen2.5:14b
